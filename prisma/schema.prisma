generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CarStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  phone     String?
  role      Role      @default(CUSTOMER)
  avatar    String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Car {
  id           String        @id @default(uuid())
  make         String
  model        String
  year         Int
  category     String        // Luxury, SUV, Sports, Electric, Sedan, Economy
  pricePerDay  Float
  status       CarStatus     @default(AVAILABLE)
  transmission Transmission  @default(AUTOMATIC)
  fuelType     FuelType      @default(PETROL)
  seats        Int           @default(5)
  horsepower   Int           @default(300)
  acceleration String        @default("4.5s (0-60)")
  mileageLimit String        @default("Unlimited")
  rating       Float         @default(4.9)
  reviewCount  Int           @default(24)
  imageUrl     String
  images       String[]
  features     String[]
  description  String
  location     String        @default("Los Angeles, CA")
  bookings     Booking[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("cars")
}

model Booking {
  id              String        @id @default(uuid())
  bookingNumber   String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId           String
  car             Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  pricePerDay     Float
  insuranceFee    Float         @default(0)
  extrasFee       Float         @default(0)
  taxFee          Float         @default(0)
  totalAmount     Float
  status          BookingStatus @default(CONFIRMED)
  pickupLocation  String
  dropoffLocation String
  insuranceTier   String        @default("Standard")
  extras          String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("bookings")
}

